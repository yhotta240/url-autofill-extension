{
  "name": "url-autofill-extension",
  "version": "0.2.0",
  "description": "URLフラグメントに指定した情報をWebフォームへ自動入力するChrome拡張機能",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "biome check src tests vitest.config.ts",
    "check:fix": "biome check --write --unsafe src tests vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run check && npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "version:patch": "exr version patch --manifest ./public/manifest.prod.json",
    "version:minor": "exr version minor --manifest ./public/manifest.prod.json",
    "version:major": "exr version major --manifest ./public/manifest.prod.json",
    "pack": "npm run build && exr pack dist/",
    "release": "npm run build && exr release dist/ --force",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "yhotta240",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/chrome": "^0.1.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "@yhotamos/extension-release-cli": "^0.5.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "marked": "^17.0.3",
    "sanitize-html": "^2.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  }
}
