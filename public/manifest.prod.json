{
  "manifest_version": 3,
  "name": "URL AutoFill",
  "short_name": "URL AutoFill",
  "version": "0.1.0",
  "description": "URLフラグメントに指定した情報をWebフォームへ自動入力するChrome拡張機能",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
